# Copy to .env and fill in from Supabase → Project Settings → API.
# These two are the ONLY backend secrets the app is allowed to ship.
# The service-role key belongs in Edge Function secrets only — never here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Leave empty to keep crash reporting completely off (the SDK is not
# even loaded). Get one from a Sentry project → Settings → Client Keys (DSN).
SENTRY_DSN=
